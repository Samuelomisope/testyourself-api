generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  directUrl         = env("DIRECT_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

model University {
  id               String            @id @default(uuid())
  name             String            @unique
  shortName        String?
  country          String            @default("Nigeria")
  domain           String?
  logoUrl          String?
  isVerified       Boolean           @default(false)
  createdAt        DateTime          @default(now())
  admins           Admin[]
  chatRooms        ChatRoom[]
  flashcardDecks   FlashcardDeck[]
  marketplaceItems MarketplaceItem[]
  studyMaterials   StudyMaterial[]
  schools          School[]
  users            User[]
  vision      String?  @db.Text
  mission     String?  @db.Text
  coreValues  String?  @db.Text
  slug            String? @unique
  establishedYear Int?
  tagline         String? @db.Text
  news            UniversityNews[]
  sourceUrl       String?
}

enum NewsStatus {
  DRAFT
  PUBLISHED
}

model UniversityNews {
  id            String     @id @default(cuid())
  universityId  String
  university    University @relation(fields: [universityId], references: [id], onDelete: Cascade)
  title         String
  excerpt       String     @db.Text
  body          String     @db.Text
  coverImageUrl String?
  sourceUrl     String?
  status        NewsStatus @default(PUBLISHED)
  publishedAt   DateTime   @default(now())
  createdAt     DateTime   @default(now())
  createdBy     String?

  @@index([universityId, status, publishedAt])
}

model User {
  refreshTokens  RefreshToken[]
  id                  String               @id @default(uuid())
  firebaseUid         String?              @unique
  displayName         String
  email               String               @unique
  photoURL            String?
  emailVerified       Boolean              @default(false)
  universityId        String?
  faculty             String?
  course              String?
  department          String?
  bio                 String?
  isVerifiedStudent   Boolean              @default(false)
  verificationStatus  VerificationStatus   @default(PENDING)
  role                Role                 @default(STUDENT)
  isPremium           Boolean              @default(false)
  streakCount         Int                  @default(0)
  lastActiveAt        DateTime             @default(now())
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  isBanned            Boolean              @default(false)
  chatSnapUsername    String?              @unique
  chatWallpaper       String?              @default("default")
  googleId            String?              @unique
  activityLogs        ActivityLog[]
  buyerProfile        BuyerProfile?
  chatRooms           ChatRoomMember[]
  feedbacks           Feedback[]
  flashcardDecks      FlashcardDeck[]
  flashcardProgress   FlashcardProgress[]
  flashcardReviewLogs FlashcardReviewLog[]
  leaderboard         LeaderboardEntry?
  marketplaceItems    MarketplaceItem[]
  messagesSent        Message[]            @relation("SentMessages")
  reactions           MessageReaction[]
  notifications       Notification[]
  reports             Report[]             @relation("ReportedBy")
  reportedItems       Report[]             @relation("ReportedUser")
  reviews             Review[]
  sellerProfile       SellerProfile?
  statuses            Status[]
  statusViews         StatusView[]
  studyMaterials      StudyMaterial[]
  university          University?          @relation(fields: [universityId], references: [id])
  isWriter       Boolean    @default(false)
  penName        String?
  writerBio      String?
  becameWriterAt DateTime?
  writerAvatarUrl String?
  novelReviews NovelReview[]
  novels         Novel[]
  askUniLibQueries AskUniLibQuery[]
  isOnline      Boolean   @default(false)
}

model RefreshToken {
  id         String    @id @default(uuid())
  userId     String
  tokenHash  String    @unique
  issuedAt   DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?
  deviceInfo String?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Admin {
  id           String     @id @default(uuid())
  firebaseUid  String     @unique
  email        String     @unique
  displayName  String
  universityId String
  createdAt    DateTime   @default(now())
  university   University @relation(fields: [universityId], references: [id])
}

model StudyMaterial {
  id             String          @id @default(uuid())
  title          String
  description    String?
  fileUrl        String
  fileType       String
  fileSize       Int?
  userId         String
  universityId   String
  faculty        String?         // DEPRECATED — kept for backward compat, prefer course.program.school
  department     String?         // DEPRECATED
  isPublic       Boolean         @default(true)
  downloadCount  Int             @default(0)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  level          String?         // DEPRECATED — prefer course.level
  semester       String?         // DEPRECATED — prefer course.semester
  course         String?         // DEPRECATED — prefer courseId relation
  courseId       String?         // NEW — nullable during transition, make required after backfill
  isDeleted      Boolean         @default(false)
  needsReview    Boolean         @default(false)

  flashcardDecks FlashcardDeck[]
  university     University      @relation(fields: [universityId], references: [id])
  user           User            @relation(fields: [userId], references: [id])
  courseRef      Course?         @relation(fields: [courseId], references: [id])
  
  fileHash                 String?               @db.VarChar(64) // SHA-256 hex digest
  classificationStatus     ClassificationStatus  @default(PENDING)
  classificationConfidence Float?                // 0-100, null until a rule/AI has run
  classificationMethod     ClassificationMethod?
  classificationReason     String?               @db.Text // human-readable: which rule fired, or why it's ambiguous
  extractedCourseCode      String?               // raw code the regex found, pre-normalization, kept for debugging/audit

  duplicateOfId String?
  duplicateOf   StudyMaterial?  @relation("DuplicateOf", fields: [duplicateOfId], references: [id])
  duplicates    StudyMaterial[] @relation("DuplicateOf")

  @@index([fileHash])
  @@index([classificationStatus])

}

model School {
  id                    String     @id @default(uuid())
  universityId          String
  name                  String     // "School of Infrastructure, Minerals and Manufacturing Engineering"
  code                  String     // "SIMME"
  label                 String     @default("School")
  admissionRequirement  String?    @db.Text
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt

  university  University    @relation(fields: [universityId], references: [id])
  staff       SchoolStaff[]
  departments Department[]

  @@unique([universityId, code]) // code unique per university, not globally
}

model SchoolStaff {
  id        String   @id @default(uuid())
  schoolId  String
  name      String
  role      String?  // "Dean", "Lecturer", "HOD"
  createdAt DateTime @default(now())

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
}
model Program {
  id                     String      @id @default(cuid())
  departmentId           String
  department             Department  @relation(fields: [departmentId], references: [id])
  name                   String
  code                   String?
  durationYears          Int?
  graduationRequirement  String?     @db.Text
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt

  courses                Course[]
  crossListedCourses ProgramCourse[]
}

model ProgramCourse {
  id        String   @id @default(cuid())
  programId String
  program   Program  @relation(fields: [programId], references: [id])
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id])
  createdAt DateTime @default(now())

  @@unique([programId, courseId])
}
model Department {
  id        String   @id @default(cuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id])
  name      String   // e.g. "Mining Engineering"
  code      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  programs  Program[]

  @@unique([schoolId, name])
}

model Course {
  id         String   @id @default(uuid())
  programId  String
  code       String   // "GNS 106"
  title      String
  synopsis   String?  @db.Text
  level      String?  // "100", "200" — matches StudyMaterial.level type
  semester   String?  // matches StudyMaterial.semester type
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  program        Program         @relation(fields: [programId], references: [id], onDelete: Cascade)
  studyMaterials StudyMaterial[]
  crossListedIn ProgramCourse[]

  @@unique([programId, code])
}


model MarketplaceItem {
  id           String        @id @default(uuid())
  title        String
  description  String
  price        Float
  category     String?
  condition    ItemCondition @default(GOOD)
  status       ListingStatus @default(ACTIVE)
  userId       String
  universityId String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  images       String[]
  tags         String[]
  type         ListingType   @default(PHYSICAL)
  university   University    @relation(fields: [universityId], references: [id])
  user         User          @relation(fields: [userId], references: [id])
  reviews      Review[]
}

model SellerProfile {
  id               String   @id @default(uuid())
  userId           String   @unique
  bio              String?
  chatSnapUsername String?
  whatsapp         String?
  rating           Float    @default(0)
  totalSales       Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id])
}

model BuyerProfile {
  id        String   @id @default(uuid())
  userId    String   @unique
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model Review {
  id        String          @id @default(uuid())
  rating    Int
  comment   String?
  userId    String
  itemId    String
  createdAt DateTime        @default(now())
  item      MarketplaceItem @relation(fields: [itemId], references: [id])
  user      User            @relation(fields: [userId], references: [id])
}

model ChatRoom {
  id           String           @id @default(uuid())
  name         String?
  isGroup      Boolean          @default(false)
  universityId String?
  createdAt    DateTime         @default(now())
  university   University?      @relation(fields: [universityId], references: [id])
  members      ChatRoomMember[]
  messages     Message[]
}

model Message {
  id        String            @id @default(uuid())
  text      String?
  senderId  String
  roomId    String
  isRead    Boolean           @default(false)
  createdAt DateTime          @default(now())
  mediaType String?
  mediaUrl  String?
  replyToId String?
  type      String            @default("text")
  replyTo   Message?          @relation("MessageReplies", fields: [replyToId], references: [id])
  replies   Message[]         @relation("MessageReplies")
  room      ChatRoom          @relation(fields: [roomId], references: [id])
  sender    User              @relation("SentMessages", fields: [senderId], references: [id])
  reactions MessageReaction[]
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  body      String
  isRead    Boolean  @default(false)
  type      String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model ActivityLog {
  id          String   @id @default(uuid())
  userId      String
  type        String
  description String
  href        String?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id])
}

model LeaderboardEntry {
  id        String   @id @default(uuid())
  userId    String   @unique
  score     Int      @default(0)
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])
}

model Report {
  id             String       @id @default(uuid())
  reportedById   String
  reportedUserId String?
  contentType    String
  contentId      String
  reason         String
  status         ReportStatus @default(PENDING)
  createdAt      DateTime     @default(now())
  reportedBy     User         @relation("ReportedBy", fields: [reportedById], references: [id])
  reportedUser   User?        @relation("ReportedUser", fields: [reportedUserId], references: [id])
}

model ChatRoomMember {
  id        String   @id @default(uuid())
  userId    String
  roomId    String
  createdAt DateTime @default(now())
  room      ChatRoom @relation(fields: [roomId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, roomId])
}

model Status {
  id        String       @id @default(uuid())
  userId    String
  text      String?
  mediaUrl  String?
  type      String       @default("text")
  expiresAt DateTime
  createdAt DateTime     @default(now())
  user      User         @relation(fields: [userId], references: [id])
  views     StatusView[]
}

model StatusView {
  id        String   @id @default(uuid())
  statusId  String
  userId    String
  createdAt DateTime @default(now())
  status    Status   @relation(fields: [statusId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([statusId, userId])
}

model MessageReaction {
  id        String   @id @default(uuid())
  messageId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())
  message   Message  @relation(fields: [messageId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([messageId, userId])
}

model Feedback {
  id        String   @id @default(uuid())
  userId    String?
  rating    Int
  category  String
  message   String
  page      String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])
}

model FlashcardDeck {
  id               String              @id @default(uuid())
  title            String
  description      String?
  userId           String
  universityId     String
  isPublic         Boolean             @default(true)
  sourceType       FlashcardSourceType @default(MANUAL)
  sourceMaterialId String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  cards            Flashcard[]
  sourceMaterial   StudyMaterial?      @relation(fields: [sourceMaterialId], references: [id])
  university       University          @relation(fields: [universityId], references: [id])
  user             User                @relation(fields: [userId], references: [id])
}
model Flashcard {
  id         String               @id @default(uuid())
  deckId     String
  front      String
  back       String
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt
  deck       FlashcardDeck        @relation(fields: [deckId], references: [id], onDelete: Cascade)
  progress   FlashcardProgress[]
  reviewLogs FlashcardReviewLog[]
}
model FlashcardProgress {
  id             String    @id @default(uuid())
  userId         String
  flashcardId    String
  easeFactor     Float     @default(2.5)
  interval       Int       @default(0)
  repetitions    Int       @default(0)
  nextReviewDate DateTime  @default(now())
  lastReviewedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  flashcard      Flashcard @relation(fields: [flashcardId], references: [id])
  user           User      @relation(fields: [userId], references: [id])

  @@unique([userId, flashcardId])
}

model FlashcardReviewLog {
  id          String       @id @default(uuid())
  flashcardId String
  userId      String
  rating      ReviewRating
  reviewedAt  DateTime     @default(now())
  flashcard   Flashcard    @relation(fields: [flashcardId], references: [id])
  user        User         @relation(fields: [userId], references: [id])
}

enum Role {
  STUDENT
  ADMIN
  SUPER_ADMIN
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
  MANUAL_REVIEW
}

enum ListingType {
  PHYSICAL
  DIGITAL
  SERVICE
}

enum ItemCondition {
  NEW
  GOOD
  FAIR
  POOR
}

enum ListingStatus {
  ACTIVE
  SOLD
  REMOVED
}

enum ReportStatus {
  PENDING
  REVIEWED
  RESOLVED
  DISMISSED
}

enum FlashcardSourceType {
  MANUAL
  AI_GENERATED
}

enum ReviewRating {
  AGAIN
  HARD
  GOOD
  EASY
}
model Novel {
  id          String      @id @default(cuid())
  title       String
  synopsis    String
  genre       Genre
  coverUrl    String?
  status      NovelStatus @default(ONGOING)
  authorId    String
  author      User        @relation(fields: [authorId], references: [id])
  episodes    Episode[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([authorId])
  @@index([genre])
  isHidden  Boolean       @default(false)
  reviews   NovelReview[]
}

model Episode {
  id            String    @id @default(cuid())
  novelId       String
  novel         Novel     @relation(fields: [novelId], references: [id], onDelete: Cascade)
  title         String
  content       String    @db.Text
  episodeNumber Int
  isPublished   Boolean   @default(false)
  releasedAt    DateTime?
  createdAt     DateTime  @default(now())

  @@unique([novelId, episodeNumber])
  @@index([novelId])
}

enum NovelStatus {
  ONGOING
  COMPLETED
  HIATUS
}

enum Genre {
  ROMANCE
  FANTASY
  THRILLER
  MYSTERY
  SCI_FI
  HORROR
  DRAMA
  ADVENTURE
  COMEDY
  ACTION
  HISTORICAL
  POETRY
}

model NovelReview {
  id        String   @id @default(cuid())
  rating    Int
  comment   String?
  userId    String
  novelId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])
  novel     Novel    @relation(fields: [novelId], references: [id], onDelete: Cascade)

  @@unique([userId, novelId])
  @@index([novelId])
}


enum AskUniLibContentType {
  LECTURE_TEXT
  EXAM_QUESTION
  MATH_QUESTION
  DIAGRAM
  MULTIPLE_QUESTIONS
  MESSY_NOTES
  TEXTBOOK_PAGE
  UNKNOWN
}

enum AskUniLibQueryStatus {
  PROCESSING
  COMPLETED
  FAILED
}

model AskUniLibQuery {
  id                    String                @id @default(cuid())
  studentId             String
  student               User                  @relation(fields: [studentId], references: [id])
  imageKey              String
  imageUrl              String
  question              String?
  extractedText         String?               @db.Text
  contentType           AskUniLibContentType?
  contentTypeConfidence Int?
  answer                String?               @db.Text
  isUncertain           Boolean?
  providerUsed          String?
  modelUsed             String?
  status                AskUniLibQueryStatus  @default(PROCESSING)
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  @@index([studentId, createdAt])
}

model StudyPlan {
  id           String   @id @default(uuid())
  userId       String
  subject      String
  examDate     DateTime?
  daysAvailable Int
  hoursPerDay  Int
  entries      Json     // [{ day, focus, tasks[] }]
  startDate    DateTime @default(now())
  createdAt    DateTime @default(now())
  active       Boolean  @default(true)
}

model ChatSession {
  id        String   @id @default(uuid())
  userId    String
  title     String?  // optional, e.g. auto-generated from first message
  summary   String?  // running AI-generated summary, updated as it grows
  messages  ChatMessage[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model ChatMessage {
  id        String   @id @default(uuid())
  sessionId String
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      String   // "user" | "assistant"
  content   String
  createdAt DateTime @default(now())

  @@index([sessionId, createdAt])
}

model AiGeneration {
  id        String   @id @default(uuid())
  userId    String
  tool      String   // "quiz" | "explain" | "revision" | "practice" | "summarize"
  title     String?
  input     Json
  result    Json
  createdAt DateTime @default(now())

  @@index([userId, tool])
}

// ============================================================
// PHASE 3 — SLICE 1: Deterministic classification + exact-dup detection
// Append these to schema.prisma, then run your usual `prisma db push`.
// ============================================================

enum ClassificationStatus {
  PENDING             // not yet processed by the pipeline
  AUTO_ORGANIZED      // resolved with high confidence, courseId set
  NEEDS_REVIEW        // resolved with medium confidence, or rule found >1 candidate
  UNABLE_TO_CLASSIFY  // no rule/AI signal at all — manual review required
  DUPLICATE           // exact hash match against an existing material
}

enum ClassificationMethod {
  RULE_COURSE_CODE  // deterministic filename/text regex + single DB match
  RULE_AMBIGUOUS    // regex matched a code, but DB returned 0 or 2+ Course rows
  AI                // reserved for the next slice
  MANUAL            // admin-entered, bypassing the pipeline entirely
}

